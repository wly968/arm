  <!-- 相邻连杆在关节处本来就连在一起，关掉自碰撞，避免折叠时互相顶住 -->
  <contact>
    <exclude body1="carriage" body2="turret"/>
    <exclude body1="turret"   body2="shoulder"/>
    <exclude body1="shoulder" body2="elbow"/>
    <exclude body1="elbow"    body2="wrist"/>
    <exclude body1="shoulder" body2="wrist"/>
    <exclude body1="wrist"    body2="gripper"/>
    <exclude body1="gripper"  body2="finger_L"/>
    <exclude body1="gripper"  body2="finger_R"/>
    <exclude body1="finger_L" body2="finger_R"/>
  </contact>

  <!-- 工具滚转暂时锁死：等式约束把 joint_tool_roll 固定在 0。
       解锁方法：删掉这条约束，并给 joint_tool_roll 加一个执行器。 -->
  <equality>
    <joint joint1="joint_tool_roll" polycoef="0 0 0 0 0"/>
  </equality>

  <actuator>
    <!-- 位置伺服；dampratio=1 让每个关节接近临界阻尼，控制更稳 -->
    <position name="yaw_pos"      joint="joint_yaw"      kp="160" dampratio="1"
              ctrlrange="-3.14 3.14" forcerange="-60 60"/>
    <position name="shoulder_pos" joint="joint_shoulder" kp="300" dampratio="1"
              ctrlrange="-2.8 2.8"   forcerange="-120 120"/>
    <position name="elbow_pos"    joint="joint_elbow"    kp="220" dampratio="1"
              ctrlrange="-2.8 2.8"   forcerange="-80 80"/>
    <position name="wrist_pos"    joint="joint_wrist"    kp="90"  dampratio="1"
              ctrlrange="-2.0 2.0"   forcerange="-30 30"/>
    <position name="finger_l_pos" joint="joint_finger_L" kp="400" dampratio="1"
              ctrlrange="0 0.030"    forcerange="-40 40"/>
    <position name="finger_r_pos" joint="joint_finger_R" kp="400" dampratio="1"
              ctrlrange="-0.030 0"   forcerange="-40 40"/>
  </actuator>

  <sensor>
    <framepos  name="ee_pos"  objtype="site" objname="ee_site"/>
    <framequat name="ee_quat" objtype="site" objname="ee_site"/>
    <touch     name="finger_L_touch" site="finger_L_pad"/>
    <touch     name="finger_R_touch" site="finger_R_pad"/>
    <jointpos  name="yaw_q"      joint="joint_yaw"/>
    <jointpos  name="shoulder_q" joint="joint_shoulder"/>
    <jointpos  name="elbow_q"    joint="joint_elbow"/>
    <jointpos  name="wrist_q"    joint="joint_wrist"/>
    <jointpos  name="finger_l_q" joint="joint_finger_L"/>
    <jointpos  name="finger_r_q" joint="joint_finger_R"/>
    <jointpos  name="tool_roll_q" joint="joint_tool_roll"/>
  </sensor>

  <!-- 初始姿态：手臂折起停在基座上方（避开两条传送带），夹爪张开 -->
  <keyframe>
    <key name="home"
         qpos="1.57 -1.15 2.0 0.725 0.0 0.030 -0.030
               -0.45 0.65 0.40 1 0 0 0
               -0.35 0.65 0.40 1 0 0 0
               -0.25 0.65 0.40 1 0 0 0"
         ctrl="1.57 -1.15 2.0 0.725 0.030 -0.030"/>
  </keyframe>

